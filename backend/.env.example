# Teacher password for the quiz live-voting backend.
# Copy this file to `.env` (kept out of version control) and fill in a real password,
# or set the environment variables directly.
#
# Plain password (hashed at startup):
TEACHER_PASSWORD=change-me
#
# …or a pre-computed Werkzeug hash (takes precedence when both are set):
# TEACHER_PASSWORD_HASH=scrypt:32768:8:1$...
#
# Comma-separated origins allowed to call the API from the browser:
# ALLOWED_ORIGINS=https://garncarz.github.io,http://localhost:8012
#
# Optional: SQLite file for persisting closed-round tallies across restarts:
# QUIZ_DB=/var/lib/algo-quiz/quiz_state.sqlite3
